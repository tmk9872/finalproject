library(HistData)
library(dplyr)
data("GaltonFamilies")
GaltonFamilies %>%
group_by(gender) %>%
summarise(
n = sum(!is.na(childHeight)),
mean = mean(childHeight, na.rm = TRUE),
sd = sd(childHeight, na.rm = TRUE),
se = sd / sqrt(n),
lower_95 = mean - qt(0.975, df = n - 1) * se,
upper_95 = mean + qt(0.975, df = n - 1) * se
)
library(HistData)
library(dplyr)
data("GaltonFamilies")
t.test(childHeight ~ 1,
data = subset(GaltonFamilies, gender == "male"))
t.test(childHeight ~ 1,
data = subset(GaltonFamilies, gender == "female"))
