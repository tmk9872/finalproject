library(dplyr)
# Standardize column names to lowercase with underscores
names(gunleg) <- tolower(gsub("[^A-Za-z0-9]+", "_", names(gunleg)))
# Inspect the standardized names
names(gunleg)
gunleg %>%
filter(grepl("waiting", law_class, ignore.case = TRUE)) %>%
count(law_class_subtype, type_of_change, sort = TRUE) %>%
print(n = Inf)
gunleg %>%
filter(grepl("waiting", law_class, ignore.case = TRUE)) %>%
count(law_class_subtype, type_of_change, sort = TRUE) %>%
tibble::as_tibble() %>%
print(n = Inf)
library(dplyr)
library(tidyr)
# 1. Select general waiting-period legislation
waiting_events <- gunleg %>%
filter(
grepl("waiting", law_class, ignore.case = TRUE),
tolower(trimws(law_class_subtype)) == "general"
) %>%
mutate(
effective_date = as.Date(sprintf(
"%04d-%02d-%02d",
as.integer(effective_date_year),
coalesce(as.integer(effective_date_month), 1L),
coalesce(as.integer(effective_date_day), 1L)
)),
firearm_scope = handguns_or_long_guns,
status = case_when(
type_of_change == "Repeal" ~ 0L,
type_of_change %in% c("Implement", "Modify") ~ 1L,
TRUE ~ NA_integer_
)
) %>%
filter(!is.na(effective_date), !is.na(status)) %>%
arrange(state, firearm_scope, effective_date)
# Inspect the individual law changes
waiting_events %>%
select(state, firearm_scope, effective_date,
type_of_change, status) %>%
as_tibble() %>%
print(n = Inf)
# 2. Create every state-year combination
state_year <- expand_grid(
state = state.name,
year = 1999:2024
)
# 3. Determine status at December 31 of each year
waiting_panel <- state_year %>%
left_join(
waiting_events,
by = "state",
relationship = "many-to-many"
) %>%
group_by(state, year, firearm_scope) %>%
summarise(
active = {
cutoff <- as.Date(paste0(first(year), "-12-31"))
eligible <- which(
!is.na(effective_date) &
effective_date <= cutoff
)
if (length(eligible) == 0) {
0L
} else {
latest <- eligible[which.max(effective_date[eligible])]
status[latest]
}
},
.groups = "drop"
) %>%
group_by(state, year) %>%
summarise(
waiting_period = as.integer(any(active == 1L)),
.groups = "drop"
)
# 4. Inspect results
head(waiting_panel)
dim(waiting_panel)
table(waiting_panel$waiting_period)
# 5. Identify states with changes during the period
waiting_panel %>%
arrange(state, year) %>%
group_by(state) %>%
mutate(previous = lag(waiting_period)) %>%
filter(!is.na(previous),
previous != waiting_period) %>%
select(state, year, previous, waiting_period) %>%
print(n = Inf)
waiting_panel %>%
filter(year %in% c(1999, 2024)) %>%
group_by(year) %>%
summarise(
n_states_with_law = sum(waiting_period),
states_with_law = paste(
state[waiting_period == 1],
collapse = ", "
),
.groups = "drop"
)
