library(NHANES)
library(dplyr)
data("NHANES")
# Variables in Proposal 2
vars <- c(
"Depressed",
"SleepHrsNight",
"PhysActive",
"Poverty",
"Age",
"Gender",
"Race1",
"Education"
)
# Confirm every variable exists
stopifnot(all(vars %in% names(NHANES)))
# Check variable types
sapply(NHANES[vars], class)
# Check categorical variable levels
lapply(
NHANES[c("Depressed", "PhysActive",
"Gender", "Race1", "Education")],
levels
)
# Restrict to intended analysis population
nhanes_adults <- NHANES %>%
filter(Age >= 20)
# Examine missingness among adults only
data.frame(
variable = vars,
missing_n = sapply(
nhanes_adults[vars],
function(x) sum(is.na(x))
),
missing_pct = round(
sapply(
nhanes_adults[vars],
function(x) mean(is.na(x)) * 100
),
1
)
)
# Number of adults with complete data
sum(complete.cases(nhanes_adults[vars]))
